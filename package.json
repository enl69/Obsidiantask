{
  "name": "obsidiantask",
  "version": "0.1.3",
  "description": "Obsidian plugin: manage Google Tasks from a side panel",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node test/build.mjs && node test/run.mjs"
  },
  "keywords": [
    "obsidian",
    "google-tasks",
    "tasks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.0",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0"
  }
}
